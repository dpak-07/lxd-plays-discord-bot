{
  "name": "all-in-one-discord-bot",
  "version": "1.0.0",
  "description": "Production-ready, multi-server Discord bot with moderation, leveling, welcome, tickets, verification, and optional music.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "build": "tsc",
    "start": "node index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "register": "tsx src/scripts/deploy-commands.ts"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discordjs",
    "moderation",
    "leveling",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@libsql/client": "^0.14.0",
    "@napi-rs/canvas": "^1.0.10",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "play-dl": "^1.9.7",
    "tweetnacl": "^1.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
